# ==========================================
# 网盘认证凭证配置 (Cloud Drive Credentials)
# ==========================================
# 夸克网盘 Cookie（登录 pan.quark.cn 后在浏览器开发者工具 Network 标头中复制）
# 或使用网页端右上角【网盘 Cookie 配置】一键自动抓取
QUARK_COOKIE=

# 百度网盘 Cookie（登录 pan.baidu.com 后在浏览器开发者工具 Network 标头中复制，必须包含 BDUSS）
# 或使用网页端右上角【网盘 Cookie 配置】一键自动抓取
BAIDU_COOKIE=

# 百度网盘新建分享的默认4位提取码（可选：留空则由系统自动生成符合规则的随机4位提取码）
BAIDU_DEFAULT_PWD=

# ==========================================
# 服务监听配置 (Server Configuration)
# ==========================================
HOST=0.0.0.0
PORT=8000

# ==========================================
# 可选：DeepSeek 大模型文案改写配置 (Optional AI Rewrite)
# 注：本项目默认搭载纯本地离线二创算法引擎，无需配置任何外部 API 即可零成本流畅运行。
# 若你希望接入外部大语言模型增强二次创作，可配置以下参数：
# ==========================================
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
